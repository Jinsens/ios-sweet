+/* Finish device init after the host reset. Error codes carry the stage. */
+static int
+ufs_device_init(void)
+{
+	uint32_t v = 0;
+	int error;
+
+	/*
+	 * Linux ufshcd_complete_dev_init(): set fDeviceInit (flag IDN 0x01),
+	 * then poll until the device clears it. Reading it without setting it
+	 * leaves the device uninitialized, so every SCSI command is rejected.
+	 */
+	error = ufs_query(0x06, 0x01, 0, 0, 0, true, &v);       /* SET_FLAG */
+	if (error)
+		return 0x8000 | (1 << 8) | (error & 0xff);
+	for (int i = 0; i < 100; i++) {
+		v = 0;
+		error = ufs_query(0x05, 0x01, 0, 0, 0, false, &v); /* READ_FLAG */
+		if (error)
+			return 0x8000 | (2 << 8) | (error & 0xff);
+		if (!(v & 1))
+			return 0;
+		delay(1000);
+	}
+	return 0x8000 | (3 << 8);
+}
