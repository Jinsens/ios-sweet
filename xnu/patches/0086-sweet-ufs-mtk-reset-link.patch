+/*
+ * One UFS query request (UPIU type 0x16). The device asserts fDeviceInit
+ * after a reset and refuses SCSI commands until the host writes the
+ * configuration descriptor back; Linux does this in ufshcd_device_init().
+ * opcode: 0x01 read descriptor, 0x02 write descriptor, 0x05 read flag.
+ */
+static int
+ufs_query(uint8_t opcode, uint8_t idn, uint8_t index, uint8_t selector,
+    uint32_t len, bool write, uint32_t *value)
+{
+	struct utrd *utrd = (struct utrd *)(su.dma + DMA_UTRL);
+	struct ucd *ucd = (struct ucd *)(su.dma + DMA_UCD);
+	uint64_t ucd_pa = su.dma_pa + DMA_UCD, bounce_pa = su.dma_pa + DMA_BOUNCE;
+	uint64_t deadline;
+
+	assert(len <= 512);
+	bzero(utrd, sizeof(*utrd));
+	bzero(ucd, sizeof(*ucd));
+
+	ucd->cmd[0] = 0x16;                     /* QUERY REQUEST UPIU */
+	ucd->cmd[1] = write ? 0x81 : 0x01;      /* standard write/read request */
+	ucd->cmd[3] = ++su.tag;
+	ucd->cmd[12] = opcode;
+	ucd->cmd[13] = idn;
+	ucd->cmd[14] = index;
+	ucd->cmd[15] = selector;
+	utrd->dw0 = (1u << 28) | ((len ? (write ? 1u : 2u) : 0u) << 25) | (1u << 24);
+	utrd->dw2 = 0x0f;
+	utrd->ucdba = (uint32_t)ucd_pa;
+	utrd->ucdbau = (uint32_t)(ucd_pa >> 32);
+	utrd->resp = (512u / 4) << 16 | (512u / 4);
+	if (len) {
+		ucd->prdt[0].addr_lo = (uint32_t)bounce_pa;
+		ucd->prdt[0].addr_hi = (uint32_t)(bounce_pa >> 32);
+		ucd->prdt[0].dbc = len - 1;
+		utrd->prdt = (1024u / 4) << 16 | 1;
+	}
+	if (su.cache) {
+		dma_clean(DMA_UTRL, sizeof(*utrd));
+		dma_clean(DMA_UCD, 16);
+		dma_sync(DMA_UCD + offsetof(struct ucd, resp), sizeof(ucd->resp));
+		if (len) {
+			dma_clean(DMA_UCD + offsetof(struct ucd, prdt), sizeof(ucd->prdt[0]));
+			if (write)
+				dma_clean(DMA_BOUNCE, len);
+			else
+				dma_sync(DMA_BOUNCE, len);
+		}
+	} else {
+		dma_sync(DMA_UTRL, sizeof(*utrd));
+		dma_sync(DMA_UCD, sizeof(*ucd));
+	}
+	__builtin_arm_dsb(0xf);
+
+	ufs_wr(REG_UTRLDBR, 1);
+	nanoseconds_to_absolutetime(CMD_TIMEOUT_NS, &deadline);
+	deadline += mach_absolute_time();
+	while (ufs_rd(REG_UTRLDBR) & 1) {
+		if (mach_absolute_time() > deadline) {
+			ufs_wr(REG_UTRLCLR, ~1u);
+			return ETIMEDOUT;
+		}
+		delay(1);
+	}
+	__builtin_arm_dsb(0xf);
+
+	if (su.cache) {
+		dma_sync(DMA_UTRL, sizeof(*utrd));
+		dma_sync(DMA_UCD, sizeof(*ucd));
+		if (len)
+			dma_sync(DMA_BOUNCE, len);
+	}
+	if (utrd->dw2 & 0xff)
+		return 0x200 | (utrd->dw2 & 0xff);
+	if (ucd->resp[0] != 0x36)
+		return 0x300;
+	*value = rd_be32(&ucd->resp[20]);       /* utp_upiu_query.value */
+	return (ucd->resp[6] || ucd->resp[7]) ? 0x400 | ucd->resp[6] : 0;
+}
