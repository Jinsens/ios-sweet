+/*
+ * Vendor ufs_mtk_host_reset: assert UniPro/HCI/crypto resets, set the
+ * XOUFS workaround bit, then cycle HCE. Only UCRDY is expected here;
+ * UTRLRDY comes after the request list is programmed and DP after link
+ * startup.
+ */
+static int
+ufs_host_reset(void)
+{
+	mmio_bits(su.pdn, 0x44, 1u << 1, 1u << 1);
+	mmio_bits(su.pdn, 0x44, 1u << 0, 1u << 0);
+	mmio_bits(su.ao, 0x44, 1u << 1, 1u << 1);
+	delay(100);
+	mmio_bits(su.ao, 0x48, 1u << 1, 1u << 1);
+	mmio_bits(su.pdn, 0x48, 1u << 0, 1u << 0);
+	mmio_bits(su.pdn, 0x48, 1u << 1, 1u << 1);
+
+	ufs_wr(REG_XOUFS_CTRL, ufs_rd(REG_XOUFS_CTRL) | 0x80);
+	ufs_wr(REG_UTRLRSR, 0);
+	ufs_wr(REG_HCE, 0);
+	for (int i = 0; i < 10000 && (ufs_rd(REG_HCE) & 1); i++) {
+		delay(1);
+	}
+	ufs_wr(REG_HCE, 1);
+	for (int i = 0; i < 100000 && !(ufs_rd(REG_HCS) & HCS_UCRDY); i++) {
+		delay(1);
+	}
+	return (ufs_rd(REG_HCS) & HCS_UCRDY) ? 0 : 0x106;
+}
