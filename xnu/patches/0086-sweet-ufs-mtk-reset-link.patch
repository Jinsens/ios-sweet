+/*
+ * Reset the UFS device through the secure monitor (vendor
+ * ufs_mtk_device_reset): RST_n is active low, keep it low >=10 us, then
+ * release and give the device 10 ms.
+ */
+static void
+ufs_device_reset(void)
+{
+	uint64_t id = MTK_SIP_UFS_CONTROL64;
+	if (ufs_smc(id, UFS_SIP_DEVICE_RESET, 0) != 0) {
+		id = MTK_SIP_UFS_CONTROL32;
+		ufs_smc(id, UFS_SIP_DEVICE_RESET, 0);
+	}
+	delay(10);
+	ufs_smc(id, UFS_SIP_DEVICE_RESET, 1);
+	delay(10000);
+}
+
+/* ufs_mtk_setup_ref_clk: REQUEST bit0, ACK bit1. */
+static uint32_t
+ufs_refclk_on(void)
+{
+	uint32_t v = ufs_rd(REG_REFCLK_CTRL);
+	if ((v & 3) == 3) {
+		return v;
+	}
+	ufs_wr(REG_REFCLK_CTRL, v | 1u);
+	for (int i = 0; i < 100000; i++) {
+		v = ufs_rd(REG_REFCLK_CTRL);
+		if ((v & 3) == 3) {
+			break;
+		}
+		delay(1);
+	}
+	return v;
+}
+
+/*
+ * One UIC command (DME_GET/DME_SET/LINK_STARTUP). Returns 0xff on timeout,
+ * otherwise the UIC result byte (0 = success).
+ */
+static uint32_t
+ufs_uic(uint32_t op, uint32_t a1, uint32_t a2, uint32_t a3, uint32_t *out3)
+{
+	uint32_t is = ufs_rd(REG_IS);
+	ufs_wr(REG_UIC_ARG1, a1);
+	ufs_wr(REG_UIC_ARG2, a2);
+	ufs_wr(REG_UIC_ARG3, a3);
+	ufs_wr(REG_IS, is);                     /* W1C */
+	ufs_wr(REG_UIC_CMD, op);
+	for (int i = 0; i < 500000; i++) {       /* 500 ms */
+		if (ufs_rd(REG_IS) & IS_UIC_COMPL) {
+			break;
+		}
+		delay(1);
+	}
+	if (out3) {
+		*out3 = ufs_rd(REG_UIC_ARG3);
+	}
+	if (!(ufs_rd(REG_IS) & IS_UIC_COMPL)) {
+		return 0xff;
+	}
+	return ufs_rd(REG_UIC_ARG2) & 0xff;
+}
+
+/* Vendor ufs_mtk_pre_link: allow UniPro power down, clear deep stall. */
+static void
+ufs_pre_link(void)
+{
+	uint32_t v = 0;
+	(void)ufs_uic(0x02, 0xd0a8u << 16, 0, 0, NULL);
+	if (ufs_uic(0x01, 0xd0a6u << 16, 0, 0, &v) == 0 && (v & (1u << 6))) {
+		(void)ufs_uic(0x02, 0xd0a6u << 16, 0, v & ~(1u << 6), NULL);
+	}
+}
