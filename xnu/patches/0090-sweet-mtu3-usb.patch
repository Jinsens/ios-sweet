+static inline void
+mt_wr(uint32_t off, uint32_t v)
+{
+	*(volatile uint32_t *)(mt.mac + off) = v;
+	__asm__ volatile ("dsb sy" ::: "memory");
+}
+
+static inline uint32_t
+mt_rd(uint32_t off)
+{
+	uint32_t v = *(volatile uint32_t *)(mt.mac + off);
+	__asm__ volatile ("dmb oshld" ::: "memory");
+	return v;
+}
+
+static inline void
+mt_iwr(uint32_t off, uint32_t v)
+{
+	*(volatile uint32_t *)(mt.ippc + off) = v;
+	__asm__ volatile ("dsb sy" ::: "memory");
+}
+
+static inline uint32_t
+mt_ird(uint32_t off)
+{
+	uint32_t v = *(volatile uint32_t *)(mt.ippc + off);
+	__asm__ volatile ("dmb oshld" ::: "memory");
+	return v;
+}
+
+static void
+mt_sleep_ms(unsigned ms)
+{
+	uint64_t deadline;
+	clock_interval_to_deadline(ms, NSEC_PER_MSEC, &deadline);
+	(void)assert_wait_deadline(&mt.sleep_chan, THREAD_UNINT, deadline);
+	thread_block(THREAD_CONTINUE_NULL);
+}
+
+static void
+mt_sync(uint32_t off, uint32_t len)
+{
+	flush_dcache64((addr64_t)(mt.dma_pa + off), len, TRUE);
+}
+
+static struct mt_gpd *
+mt_gpd(uint32_t ring_off, uint32_t idx)
+{
+	return (struct mt_gpd *)(mt.dma + ring_off) + idx;
+}
+
+static void
+mt_gpd_tx(uint32_t idx, uint32_t buf_off, uint32_t len, bool zlp)
+{
+	volatile struct mt_gpd *g = mt_gpd(MT_TX_GPD_OFF, idx);
+	uint64_t bpa = mt.dma_pa + buf_off;
+	uint64_t npa = mt.dma_pa + MT_TX_GPD_OFF + ((idx + 1) % MT_TX_GPD_N) * sizeof(struct mt_gpd);
+
+	g->buf = (uint32_t)bpa;
+	g->next = (uint32_t)npa;
+	g->dw3 = len & 0xfffff;
+	__asm__ volatile ("dmb sy" ::: "memory");
+	g->dw0 = (((uint32_t)(bpa >> 32) & 0xf) << 24) |
+	    (((uint32_t)(npa >> 32) & 0xf) << 28) |
+	    (zlp ? MT_GPD_ZLP : 0) | MT_GPD_IOC | MT_GPD_HWO;
+	mt_sync(MT_TX_GPD_OFF, MT_TX_GPD_N * sizeof(struct mt_gpd));
+}
+
+static void
+mt_gpd_rx(uint32_t idx, uint32_t buf_off, uint32_t len)
+{
+	volatile struct mt_gpd *g = mt_gpd(MT_RX_GPD_OFF, idx);
+	uint64_t bpa = mt.dma_pa + buf_off;
+	uint64_t npa = mt.dma_pa + MT_RX_GPD_OFF + ((idx + 1) % MT_RX_GPD_N) * sizeof(struct mt_gpd);
+
+	g->buf = (uint32_t)bpa;
+	g->next = (uint32_t)npa;
+	g->dw3 = (((uint32_t)(bpa >> 32) & 0xf) << 24) |
+	    (((uint32_t)(npa >> 32) & 0xf) << 28);
+	__asm__ volatile ("dmb sy" ::: "memory");
+	g->dw0 = ((len & 0xfffff) << 12) | MT_GPD_IOC | MT_GPD_HWO;
+	mt_sync(MT_RX_GPD_OFF, MT_RX_GPD_N * sizeof(struct mt_gpd));
+}
+
+static void
+mt_gpd_int(uint32_t idx, uint32_t len)
+{
+	volatile struct mt_gpd *g = mt_gpd(MT_INT_GPD_OFF, idx);
+	uint64_t bpa = mt.dma_pa + MT_NOTIFY_OFF;
+	uint64_t npa = mt.dma_pa + MT_INT_GPD_OFF + ((idx + 1) % MT_INT_GPD_N) * sizeof(struct mt_gpd);
+
+	g->buf = (uint32_t)bpa;
+	g->next = (uint32_t)npa;
+	g->dw3 = len & 0xfffff;
+	__asm__ volatile ("dmb sy" ::: "memory");
+	g->dw0 = (((uint32_t)(bpa >> 32) & 0xf) << 24) |
+	    (((uint32_t)(npa >> 32) & 0xf) << 28) | MT_GPD_IOC | MT_GPD_HWO;
+	mt_sync(MT_INT_GPD_OFF, MT_INT_GPD_N * sizeof(struct mt_gpd));
+}
