+#if defined(SWEET)
+/*
+ * do_cacheid() measures the geometry of one core per cluster type.  Cores that
+ * have not run yet leave the measured sizes at zero, and a cluster type that is
+ * not in the boot set (cpus=N) is never measured at all.  The ADT describes
+ * every CPU, so use it to answer cache-size queries; the measured geometry is
+ * still what drives cache maintenance and VM cache coloring.
+ */
+static uint32_t
+sweet_topology_cache_size(cluster_type_t cluster_type, boolean_t outermost)
+{
+	const ml_topology_info_t *topology = ml_get_topology_info();
+	uint32_t size = 0;
+
+	for (unsigned int i = 0; i < topology->num_cpus; i++) {
+		const ml_topology_cpu_t *cpu = &topology->cpus[i];
+		uint32_t candidate;
+
+		if (cpu->cluster_type != cluster_type) {
+			continue;
+		}
+		candidate = outermost ? cpu->l3_cache_size : cpu->l2_cache_size;
+		if (candidate > size) {
+			size = candidate;
+		}
+	}
+	return size;
 }
+#endif /* SWEET */
 
