+	}
+	sweet_mark(86, sweet_disp_calls, sweet_disp_pushes);
+	sweet_mark(92, sweet_disp_busy_skips, sweet_disp_status);
+	sweet_mark(90, sweet_disp_target[0], sweet_disp_target[1]);
+	sweet_mark(91, sweet_disp_target[2], sweet_disp_target[3]);
+	sweet_mark(93, sweet_disp_target[4], sweet_disp_status_before);
+	sweet_mark(94, sweet_disp_cmdq[0], sweet_disp_cmdq[1]);
+	sweet_mark(95, sweet_disp_cmdq[2], sweet_disp_cmdq[3]);
 	printf("SWEET UFS: \"%s\" on LUN %u: first block 0x%llx, %llu MiB, %s, DMA at 0x%llx\n",
 	    want, su.lun, su.first_block, su.nblocks * UFS_BLOCK >> 20,
 	    su.writable ? "read-write" : "read-only", su.dma_pa);
@@ -994,8 +1092,12 @@
 	sweet_sample_start();
