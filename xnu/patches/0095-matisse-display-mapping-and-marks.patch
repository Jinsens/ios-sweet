+/*
+ * Boot progress marks.
+ *
+ * The only console on this board is a framebuffer that stays dark, and the
+ * persistent log ring cannot help: it is fed from _cnputs(), which is never
+ * called before a console exists, and its writes go through
+ * ufs_write_blocks(), which refuses everything while the partition is
+ * read-only (ufsrw=0). A bring-up that hangs therefore leaves no evidence
+ * at all - the phone just resets on the watchdog.
+ *
+ * This is the minimal evidence channel that does not depend on any of that:
+ * a 2.3 KiB record kept in BSS and rewritten, one block at a time, into the
+ * LAST block of the partition (inside the log ring area, so no filesystem
+ * block is touched). The write bypasses su.writable on purpose - it is the
+ * only writer that may run on a read-only boot, and it only ever touches
+ * that one block. After the phone resets, a recovery `dd` of the last block
+ * shows how far the kernel got.
+ */
+#define SWEET_MARK_MAX  96
+
+/* Bumped for every locally built kernel that is flashed to the phone. */
+#define SWEET_BUILD_ID 0x2303u
+
+struct sweet_mark_rec {
+	uint32_t code;
+	uint32_t pad;
+	uint64_t a, b;
+};
+
+struct sweet_mark_blk {
+	char magic[8];
+	uint32_t version, count;
+	struct sweet_mark_rec rec[SWEET_MARK_MAX];
+};
+
+static struct sweet_mark_blk sweet_marks;
+
+void
+sweet_mark(uint32_t code, uint64_t a, uint64_t b)
+{
+	uint8_t *bounce;
+	uint64_t lba;
+	uint8_t cdb[10];
+
+	if (su.dma == 0 || su.nblocks == 0 || sweet_marks.count >= SWEET_MARK_MAX) {
+		return;
+	}
+	if (sweet_marks.magic[0] == 0) {
+		memcpy(sweet_marks.magic, "SWEETMRK", 8);
+		sweet_marks.version = 1;
+	}
+	sweet_marks.rec[sweet_marks.count].code = code;
+	sweet_marks.rec[sweet_marks.count].a = a;
+	sweet_marks.rec[sweet_marks.count].b = b;
+	sweet_marks.count++;
+
+	bounce = (uint8_t *)(su.dma + DMA_BOUNCE);
+	lba = su.first_block + su.nblocks - 1;
+	/*
+	 * ufs_scsi() owns one UTRL/UCD/PRDT set at the head of the same DMA
+	 * allocation, so marks must not overlap another transfer - after
+	 * mountroot the HFS read path runs concurrently.
+	 */
+	lck_mtx_lock(&sweet_ufs_lock);
+	bzero(bounce, UFS_BLOCK);
+	memcpy(bounce, &sweet_marks, MIN(sizeof(sweet_marks), UFS_BLOCK));
+	cdb[0] = 0x2a;                          /* WRITE(10), one block */
+	cdb[1] = 0;
+	cdb[2] = (uint8_t)(lba >> 24);
+	cdb[3] = (uint8_t)(lba >> 16);
+	cdb[4] = (uint8_t)(lba >> 8);
+	cdb[5] = (uint8_t)lba;
+	cdb[6] = 0;
+	cdb[7] = 0;
+	cdb[8] = 1;
+	cdb[9] = 0;
+	(void)ufs_scsi(cdb, sizeof(cdb), UFS_BLOCK, true);
+	lck_mtx_unlock(&sweet_ufs_lock);
+}
