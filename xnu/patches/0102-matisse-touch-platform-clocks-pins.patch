 static uint32_t
+mt_mmio_rd(vm_offset_t base, uint32_t off)
+{
+	__asm__ volatile("dmb oshld" ::: "memory");
+	uint32_t value = *(volatile uint32_t *)(base + off);
+	__asm__ volatile("dmb oshld" ::: "memory");
+	return value;
+}
+
+static void
+mt_mmio_wr(vm_offset_t base, uint32_t off, uint32_t value)
+{
+	__asm__ volatile("dmb oshst" ::: "memory");
+	*(volatile uint32_t *)(base + off) = value;
+	__asm__ volatile("dsb osh" ::: "memory");
+}
+
+/* Match the pin and clock selections observed on the live Recovery DT. */
+static int
+mt_matisse_platform_init(void)
+{
+	if (!mt.topckgen) mt.topckgen = ml_io_map(MTK_TOPCKGEN_PA, 0x100u);
+	if (!mt.pericfg) mt.pericfg = ml_io_map(MTK_PERICFG_AO_PA, 0x100u);
+	if (!mt.pio) mt.pio = ml_io_map(MTK_PIO_PA, 0x500u);
+	if (!mt.iocfg_bm) mt.iocfg_bm = ml_io_map(MTK_IOCFG_BM_PA, 0x100u);
+	if (!mt.topckgen || !mt.pericfg || !mt.pio || !mt.iocfg_bm) {
+		return ENOMEM;
+	}
+
+	/* SPI_SEL uses parent 1 (UNIVPLL_D6_D2) at 208 MHz on this board. */
+	mt_mmio_wr(mt.topckgen, MTK_TOP_CLK_CFG_7_SET, MTK_SPI6_CLK_PDN);
+	mt_mmio_wr(mt.topckgen, MTK_TOP_CLK_CFG_7_CLR, MTK_SPI6_CLK_PARENT_MASK);
+	mt_mmio_wr(mt.topckgen, MTK_TOP_CLK_CFG_7_SET, MTK_SPI6_CLK_PARENT);
+	mt_mmio_wr(mt.topckgen, MTK_TOP_CLK_UPDATE_0, MTK_SPI6_CLK_UPDATE);
+	mt_mmio_wr(mt.topckgen, MTK_TOP_CLK_CFG_7_CLR, MTK_SPI6_CLK_PDN);
+
+	/* Enable SPI6's bus clock and its companion register-interface clock. */
+	uint32_t gate = mt_mmio_rd(mt.pericfg, MTK_PERI_AO_CG);
+	gate &= ~(MTK_SPI6_BCLK_GATE | MTK_SPI6_HCLK_GATE);
+	mt_mmio_wr(mt.pericfg, MTK_PERI_AO_CG, gate);
+
+	/* GPIO164..167: SPI6_B MI/CSB/MO/CLK, mux function 2. */
+	mt_mmio_wr(mt.pio, MTK_SPI6_PIO_MODE_MWR, MTK_SPI6_PIO_MODE_2);
+	/* MT6983 pinctrl encodes drive-strength=<7> as raw value 7. */
+	mt_mmio_wr(mt.iocfg_bm, MTK_SPI6_DRV_SET, MTK_SPI6_DRV_FIELDS);
+
+	mt.clock_cfg = mt_mmio_rd(mt.topckgen, MTK_TOP_CLK_CFG_7);
+	mt.peri_gate = mt_mmio_rd(mt.pericfg, MTK_PERI_AO_CG);
+	mt.pin_mode = mt_mmio_rd(mt.pio, 0x440u);
+	mt.pin_drive = mt_mmio_rd(mt.iocfg_bm, 0x000u);
+	mt.platform_ready = true;
+	printf("SWEET MT TOUCH: platform clk=%#x gate=%#x pin=%#x drv=%#x\n",
+	    mt.clock_cfg, mt.peri_gate, mt.pin_mode, mt.pin_drive);
+	return 0;
+}
+
+static void
+mt_mark_platform(void)
+{
+	if (mt.trace && mt.platform_ready) {
+		sweet_mark(100, ((uint64_t)mt.clock_cfg << 32) | mt.peri_gate,
+		    ((uint64_t)mt.pin_mode << 32) | mt.pin_drive);
+	}
+}
