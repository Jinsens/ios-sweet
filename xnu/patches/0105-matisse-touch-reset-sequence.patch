+/* Release the active-low touch reset exactly as the Recovery FTS driver does. */
+static int
+mt_touch_reset_init(void)
+{
+	uint32_t mode = mt_mmio_rd(mt.pio, MTK_GPIO_MODE0);
+	uint32_t dir = mt_mmio_rd(mt.pio, MTK_GPIO_DIR0);
+	uint32_t dout = mt_mmio_rd(mt.pio, MTK_GPIO_DOUT0);
+	uint64_t before = ((uint64_t)((mode >> (MTK_TOUCH_RESET_GPIO * 4u)) & 0xfu) << 32) |
+	    ((uint64_t)((dir & MTK_TOUCH_RESET_MASK) != 0) << 1) |
+	    ((dout & MTK_TOUCH_RESET_MASK) != 0);
+
+	/* GPIO3 function 0 via MT6983's mode write-mask register. */
+	mt_mmio_wr(mt.pio, MTK_GPIO_MODE0_MWR,
+	    0x8u << (MTK_TOUCH_RESET_GPIO * 4u));
+	/* Drive reset low before enabling the output driver. */
+	mt_mmio_wr(mt.pio, MTK_GPIO_DOUT0_CLR, MTK_TOUCH_RESET_MASK);
+	mt_mmio_wr(mt.pio, MTK_GPIO_DIR0_SET, MTK_TOUCH_RESET_MASK);
+	delay(10000); /* Recovery FTS holds reset low before releasing it. */
+
+	mt_mmio_wr(mt.pio, MTK_GPIO_DOUT0_SET, MTK_TOUCH_RESET_MASK);
+	delay(100000); /* Allow the controller to leave reset and start its clock. */
+
+	mode = mt_mmio_rd(mt.pio, MTK_GPIO_MODE0);
+	dir = mt_mmio_rd(mt.pio, MTK_GPIO_DIR0);
+	dout = mt_mmio_rd(mt.pio, MTK_GPIO_DOUT0);
+	uint64_t after = ((uint64_t)((mode >> (MTK_TOUCH_RESET_GPIO * 4u)) & 0xfu) << 32) |
+	    ((uint64_t)((dir & MTK_TOUCH_RESET_MASK) != 0) << 1) |
+	    ((dout & MTK_TOUCH_RESET_MASK) != 0);
+	printf("SWEET MT TOUCH: reset GPIO3 before=%#llx after=%#llx\n",
+	    (unsigned long long)before, (unsigned long long)after);
+	if (mt.trace) {
+		sweet_mark(104, before, after);
+	}
+	return (((mode >> (MTK_TOUCH_RESET_GPIO * 4u)) & 0xfu) == 0 &&
+	    (dir & MTK_TOUCH_RESET_MASK) != 0 &&
+	    (dout & MTK_TOUCH_RESET_MASK) != 0) ? 0 : EIO;
+}
