+/*
+ * Read-only probe of the two MT6373 rails that supply the panel controller.
+ * The live device tree names them as the fts node's vdd-supply (VRF18_AIF)
+ * and avdd-supply (VTP); Recovery reports both enabled at 1.8 V and 3.3 V.
+ */
+static void
+mt_supply_probe(uint32_t mark_id)
+{
+	uint8_t vrf_en = 0xff, vtp_en = 0xff, vrf_v = 0xff, vtp_v = 0xff;
+	int e0 = -1, e1 = -1, e2 = -1, e3 = -1;
+	int init = sweet_spmi_init();
+
+	if (init == 0) {
+		e0 = sweet_spmi_read(5, 0x1bbf, &vrf_en); /* VRF18_AIF enable */
+		e1 = sweet_spmi_read(5, 0x1d23, &vtp_en); /* VTP enable */
+		e2 = sweet_spmi_read(5, 0x1e8d, &vrf_v);  /* VRF18_AIF vosel */
+		e3 = sweet_spmi_read(5, 0x1e35, &vtp_v);  /* VTP vosel */
+	}
+	sweet_mark(mark_id, ((uint64_t)vrf_en << 32) | ((uint32_t)e0 & 0xffu),
+	    ((uint64_t)vtp_en << 32) | ((uint32_t)e1 & 0xffu));
+	sweet_mark(mark_id + 1, ((uint64_t)vrf_v << 32) | ((uint32_t)e2 & 0xffu),
+	    ((uint64_t)vtp_v << 32) | ((uint32_t)e3 & 0xffu));
+	printf("SWEET MT TOUCH: mt6373 vrf18 en=%#x/%d vtp en=%#x/%d "
+	    "vosel=%#x/%d %#x/%d\n", vrf_en, e0, vtp_en, e1, vrf_v, e2, vtp_v, e3);
+
+	if (mark_id != 141) {
+		return;
+	}
+	/* Attribution only on the first pass: PMIF state, lanes, battery block. */
+	uint32_t pmif_init = 0, inf = 0, arb_en = 0, cmdissue = 0, sta = 0;
+	sweet_spmi_pmif(&pmif_init, &inf, &arb_en, &cmdissue, &sta);
+	sweet_mark(151, ((uint64_t)pmif_init << 32) | inf,
+	    ((uint64_t)arb_en << 32) | cmdissue);
+	sweet_mark(153, sta, sweet_spmi_last_sta());
+
+	uint32_t arb = 0, map0 = 0, map1 = 0;
+	unsigned count = 0, ap0 = 0, ow0 = 0, ap1 = 0, ow1 = 0;
+	sweet_spmi_info(&arb, &count);
+	int l0 = sweet_spmi_lane(5, 0x1b, &map0, &ap0, &ow0);
+	int l1 = sweet_spmi_lane(5, 0x1d, &map1, &ap1, &ow1);
+	sweet_mark(147, ((uint64_t)count << 32) | ((uint32_t)pmif_init & 0xffu),
+	    arb);
+	sweet_mark(148, ((uint64_t)(l0 & 0xff) << 40) | ((uint64_t)ap0 << 20) |
+	    ((uint64_t)ow0 << 16), map0);
+	sweet_mark(149, ((uint64_t)(l1 & 0xff) << 40) | ((uint64_t)ap1 << 20) |
+	    ((uint64_t)ow1 << 16), map1);
+	uint8_t ctl = 0;
+	int ce = sweet_spmi_read(0, 0x1000, &ctl);
+	sweet_mark(150, ((uint64_t)ctl << 32) | ((uint32_t)ce & 0xffu), 0);
+	printf("SWEET MT TOUCH: spmi pmif=%#x/%#x/%#x sta=%#x ctl=%#x/%d\n",
+	    pmif_init, inf, arb_en, cmdissue, sta, ctl, ce);
+}
+
+/*
+ * LDO soft-start helper: one selector step at a time, keeping the upper
+ * nibble of the register and giving the rail 5 ms to settle between steps.
+ * Jumping VTP from 1.8 V straight to 3.3 V browns the SoC out every time;
+ * a stepped ramp is what a regulator framework would do through
+ * set_voltage() when the constraint changes by more than one range.
+ */
+static int
+mt_rail_ramp(unsigned reg, uint8_t before, unsigned target, uint32_t mark_id)
+{
+	unsigned cur = before & 0xfu;
+	uint8_t high = (uint8_t)(before & 0xf0u);
+
+	if (cur > 15u) {
+		return -1;
+	}
+	sweet_mark(mark_id, ((uint64_t)reg << 32) | cur, 0x524d5030); /* "RMP0" */
+	while (cur != target) {
+		cur = (cur < target) ? cur + 1u : cur - 1u;
+		int err = sweet_spmi_write(5, reg, (uint8_t)(high | cur));
+		if (err != 0) {
+			return err;
+		}
+		delay(5000);
+	}
+	sweet_mark(mark_id + 1, ((uint64_t)reg << 32) | cur, 0x524d5031);
+	return 0;
+}
+
+/*
+ * Bring the two MT6373 rails up the way the Recovery FTS probe does. Only
+ * reachable with sweettouchpower=1 and only through the MT6373 LDO control
+ * registers, so no other regulator can be touched. The SID 0 battery block is
+ * read first: 0x4804 must return 0x0d, which proves the 16-bit PMIF address
+ * reaches the right byte before any rail conclusion is drawn.
+ */
+static void
+mt_supply_power_on(void)
+{
+	uint8_t vrf = 0, vtp = 0;
+	int e0, e1, w = -1, w2 = -1;
+	uint32_t pre = 0, post = 0, clr = 0;
+
+	sweet_mark(160, 0x504f57, 0); /* "POW": entered */
+	int irc = sweet_spmi_init();
+	uint32_t init_done = 0, sta0 = 0;
+	sweet_spmi_pmif(&init_done, NULL, NULL, NULL, &sta0);
+	sweet_mark(161, ((uint64_t)(uint32_t)irc << 32) | (init_done & 0xffffffffu),
+	    sta0);
+	if (irc != 0) {
+		printf("SWEET MT TOUCH: power on skipped, SPMI unavailable\n");
+		return;
+	}
+
+	uint32_t grp = 0, req = 0;
+	sweet_spmi_mst(&grp, &req);
+	sweet_mark(171, ((uint64_t)grp << 32) | req, 0);
+
+	/*
+	 * Discriminator: write each control register back with the value it
+	 * already holds. Nothing changes electrically, so a fatal outcome here
+	 * means the PMIF write path is what kills the SoC, not the rail.
+	 */
+	int noop = 0;
+	(void)PE_parse_boot_argn("sweetnoop", &noop, sizeof(noop));
+	if (noop) {
+		uint8_t c1 = 0, c2 = 0, c3 = 0, c4 = 0;
+		(void)sweet_spmi_read(5, 0x1e35, &c1);
+		int n1 = sweet_spmi_write(5, 0x1e35, c1);
+		sweet_mark(186, ((uint64_t)(uint32_t)n1 << 32) | c1, 0x4e4f4f50);
+		(void)sweet_spmi_read(5, 0x1e8d, &c2);
+		int n2 = sweet_spmi_write(5, 0x1e8d, c2);
+		sweet_mark(187, ((uint64_t)(uint32_t)n2 << 32) | c2, 0x4e4f4f50);
+		(void)sweet_spmi_read(5, 0x1d23, &c3);
+		int n3 = sweet_spmi_write(5, 0x1d23, c3);
+		sweet_mark(188, ((uint64_t)(uint32_t)n3 << 32) | c3, 0x4e4f4f50);
+		(void)sweet_spmi_read(5, 0x1bbf, &c4);
+		int n4 = sweet_spmi_write(5, 0x1bbf, c4);
+		sweet_mark(189, ((uint64_t)(uint32_t)n4 << 32) | c4, 0x4e4f4f50);
+		printf("SWEET MT TOUCH: noop writes %d/%d/%d/%d\n", n1, n2, n3, n4);
+		return;
+	}
+
+	/* Addressing proof first, on a fresh channel. */
+	uint8_t c0 = 0, c1 = 0;
+	int q0 = sweet_spmi_read(4, 0x4804, &c0);
+	uint32_t q0p = pre, q0c = clr, q0s = post;
+	sweet_spmi_sta3(&q0p, &q0s, &q0c);
+	int q1 = sweet_spmi_read(4, 0x4808, &c1);
+	uint32_t q1p = pre, q1s = post, q1c = clr;
+	sweet_spmi_sta3(&q1p, &q1s, &q1c);
+	sweet_mark(168, ((uint64_t)c0 << 32) | ((uint32_t)q0 & 0xffu),
+	    ((uint64_t)q0p << 32) | q0c);
+	sweet_mark(169, ((uint64_t)c1 << 32) | ((uint32_t)q1 & 0xffu),
+	    ((uint64_t)q1p << 32) | q1c);
+
+	e0 = sweet_spmi_read(5, 0x1bbf, &vrf);
+	e1 = sweet_spmi_read(5, 0x1d23, &vtp);
+	sweet_spmi_sta3(&pre, &post, &clr);
+	sweet_mark(162, ((uint64_t)vrf << 32) | ((uint32_t)e0 & 0xffu),
+	    ((uint64_t)vtp << 32) | ((uint32_t)e1 & 0xffu));
+	sweet_mark(170, ((uint64_t)post << 32) | clr, pre);
+	if (e0 != 0 || e1 != 0) {
+		printf("SWEET MT TOUCH: power on skipped, read failed %d/%d\n",
+		    e0, e1);
+		return;
+	}
+
+	/*
+	 * VTP's LP bit is the last known difference from the working Recovery
+	 * state (0x01 there, 0x03 here). Clearing it after the 3.3 V ramp kills
+	 * the SoC, so this variant does it first, at 1.8 V, before anything is
+	 * using the rail.
+	 */
+	int vtplp = 0;
+	(void)PE_parse_boot_argn("sweetvtplp", &vtplp, sizeof(vtplp));
+	if (vtplp) {
+		sweet_mark(179, ((uint64_t)vtp << 32) | 0x01u, 0x5654);
+		w = sweet_spmi_write(5, 0x1d23, 1u);
+		delay(20000);
+		sweet_mark(163, ((uint64_t)(uint32_t)w << 32) | 0x5654u, vtp);
+	}
+
+	/*
+	 * fts_power_cycle asserts reset before power comes up, so hold the line
+	 * low for the whole rail sequence.
+	 */
+	mt_mmio_wr(mt.pio, MTK_GPIO_DOUT0_CLR, MTK_TOUCH_RESET_MASK);
+	delay(2000);
+
+	/*
+	 * Power sequencing, in the order a regulator framework would do it:
+	 * hold both rails off, program the selectors, then bring vdd up first
+	 * and avdd second. Writing a selector while the LDO is enabled and
+	 * driving a load glitched the PMIC hard enough to take the SoC with it
+	 * on the last three boots, so every selector moves with the rail off.
+	 */
+	/*
+	 * Isolation order: the VTP selector first (VTP is already enabled at
+	 * 1.8 V), then VRF18_AIF's selector while that rail is still off, then
+	 * avdd's enable/LP byte. Marks sit between each so a fatal write is
+	 * attributable instead of taking the whole sequence with it. Disabling
+	 * VTP first is deliberately absent: it killed the SoC twice, in the
+	 * worker and here before the root mount.
+	 */
+	/*
+	 * The bootloader leaves VRF18_AIF at selector 7 (ldo_volt_table3[7] =
+	 * 1.3 V) and VTP at selector 4 (ldo_volt_table1[4] = 1.8 V), while the
+	 * device tree pins them at 1.8 V and 3.3 V. The Recovery kernel
+	 * corrects VTP during regulator registration ("mt6373_vtp: Bringing
+	 * 1800000uV into 3300000-3300000uV"); XNU never did.
+	 */
+	uint8_t vrf_v = 0, vtp_v = 0;
+	int v0 = sweet_spmi_read(5, 0x1e8d, &vrf_v);
+	int v1 = sweet_spmi_read(5, 0x1e35, &vtp_v);
+	sweet_mark(176, ((uint64_t)vrf_v << 32) | ((uint32_t)v0 & 0xffu),
+	    ((uint64_t)vtp_v << 32) | ((uint32_t)v1 & 0xffu));
+
+	int w3 = -1, w4 = -1;
+	if (v0 == 0 && (vrf_v & 0xfu) != 12u) { /* 1.3 V -> 1.8 V in 100 mV steps */
+		w3 = mt_rail_ramp(0x1e8d, vrf_v, 12u, 190);
+	}
+	if (v1 == 0 && vtp_v != 0 && (vtp_v & 0xfu) != 13u) { /* 1.8 V -> 3.3 V */
+		w4 = mt_rail_ramp(0x1e35, vtp_v, 13u, 192);
+	}
+	uint8_t vrf_v2 = 0, vtp_v2 = 0;
+	int v2 = sweet_spmi_read(5, 0x1e8d, &vrf_v2);
+	int v3 = sweet_spmi_read(5, 0x1e35, &vtp_v2);
+	sweet_mark(177, ((uint64_t)vrf_v2 << 32) | ((uint32_t)v2 & 0xffu),
+	    ((uint64_t)vtp_v2 << 32) | ((uint32_t)v3 & 0xffu));
+	printf("SWEET MT TOUCH: vosel vrf=%#x->%#x/%d vtp=%#x->%#x/%d "
+	    "ramp=%d/%d\n", vrf_v, vrf_v2, v2, vtp_v, vtp_v2, v3, w3, w4);
+
+	/* vdd first (fts_enable_reg order), then avdd with LP cleared. */
+	if ((vrf & 1u) == 0) {
+		w2 = sweet_spmi_write(5, 0x1bbf, 1u);
+	}
+	sweet_mark(164, ((uint64_t)(uint32_t)w2 << 32) | 0x5652u, vrf);
+	delay(20000);
+
+
+
+	uint8_t s1 = 0, s2 = 0;
+	int s1e = sweet_spmi_read(5, 0x1bbf, &s1);
+	int s2e = sweet_spmi_read(5, 0x1d23, &s2);
+	sweet_mark(180, ((uint64_t)s1 << 32) | ((uint32_t)s1e & 0xffu),
+	    ((uint64_t)s2 << 32) | ((uint32_t)s2e & 0xffu));
+	uint8_t t1 = 0, t2 = 0;
+	int t1e = sweet_spmi_read(5, 0x1e8d, &t1);
+	int t2e = sweet_spmi_read(5, 0x1e35, &t2);
+	sweet_mark(181, ((uint64_t)t1 << 32) | ((uint32_t)t1e & 0xffu),
+	    ((uint64_t)t2 << 32) | ((uint32_t)t2e & 0xffu));
+
+	delay(20000);
+	uint8_t a0 = 0, a1 = 0;
+	int r0 = sweet_spmi_read(5, 0x1bbf, &a0);
+	uint32_t r0c = clr;
+	sweet_spmi_sta3(NULL, NULL, &r0c);
+	int r1 = sweet_spmi_read(5, 0x1d23, &a1);
+	uint32_t r1c = clr;
+	sweet_spmi_sta3(NULL, NULL, &r1c);
+	sweet_mark(165, ((uint64_t)a0 << 32) | ((uint32_t)r0 & 0xffu),
+	    ((uint64_t)a1 << 32) | ((uint32_t)r1 & 0xffu));
+	printf("SWEET MT TOUCH: rails before=%#x/%#x write=%d/%d after=%#x/%#x\n",
+	    vrf, vtp, w, w2, a0, a1);
+
+	/* 15 ms after both rails, release reset and let the chip boot. */
+	delay(15000);
+	mt_mmio_wr(mt.pio, MTK_GPIO_DOUT0_SET, MTK_TOUCH_RESET_MASK);
+	delay(120000);
+	uint32_t mode = mt_mmio_rd(mt.pio, 0x440u);
+	uint32_t dir = mt_mmio_rd(mt.pio, MTK_GPIO_DIR0);
+	sweet_mark(166, ((uint64_t)((dir >> MTK_TOUCH_RESET_GPIO) & 1u) << 32) |
+	    mt_gpio_din(MTK_TOUCH_RESET_GPIO), mode);
+
+	/*
+	 * The Recovery driver's first transaction after opening the channel is a
+	 * one-byte system reset (0x81) followed by a ~20 ms wait; only then does
+	 * it read any register.
+	 */
+	uint8_t cmd = 0x81, rst = 0;
+	int rerr = mt_spi_xfer(&cmd, &rst, 1);
+	delay(20000);
+	uint8_t probe = 0;
+	(void)mt_spi_xfer(&cmd, &probe, 1);
+	sweet_mark(167, ((uint64_t)(uint32_t)rerr << 32) | rst, probe);
+
+	/*
+	 * FW VER lives at 0x20000004 and the Recovery driver reports 0x0020
+	 * there, so a non-zero reply proves the chip runs even if the chip-ID
+	 * address is wrong.
+	 */
+	static const uint8_t fw_tx[8] = {
+		0xfb, 0x20, 0x00, 0x00, 0x04, 0xff, 0xff, 0xff,
+	};
+	uint8_t fw_rx[8];
+	memset(fw_rx, 0xee, sizeof(fw_rx));
+	int ferr = mt_spi_xfer(fw_tx, fw_rx, sizeof(fw_rx));
+	sweet_mark(172, mt_pack4(fw_rx), mt_pack4(fw_rx + 4));
+	printf("SWEET MT TOUCH: fw ver err=%d rx=%02x%02x%02x%02x%02x%02x%02x%02x\n",
+	    ferr, fw_rx[0], fw_rx[1], fw_rx[2], fw_rx[3], fw_rx[4], fw_rx[5],
+	    fw_rx[6], fw_rx[7]);
+
+	/* Chip ID at 0x20000000, the same frame the production path sends. */
+	static const uint8_t id_tx[8] = {
+		0xfb, 0x20, 0x00, 0x00, 0x00, 0xff, 0xff, 0xff,
+	};
+	uint8_t id_rx[8];
+	memset(id_rx, 0xee, sizeof(id_rx));
+	int ierr = mt_spi_xfer(id_tx, id_rx, sizeof(id_rx));
+	sweet_mark(178, ((uint64_t)mt_pack4(id_rx) << 32) | ((uint32_t)ierr & 0xffu),
+	    mt_pack4(id_rx + 4));
+	printf("SWEET MT TOUCH: id err=%d rx=%02x%02x%02x%02x%02x%02x%02x%02x\n",
+	    ierr, id_rx[0], id_rx[1], id_rx[2], id_rx[3], id_rx[4], id_rx[5],
+	    id_rx[6], id_rx[7]);
+
+	printf("SWEET MT TOUCH: addr type=%#x/%d present=%#x/%d "
+	    "vrf=%#x/%d vtp=%#x/%d sysrst=%d\n",
+	    c0, q0, c1, q1, a0, r0, a1, r1, rerr);
+}
+
+/*
+ * Watch the four SPI6_B pads during a long transfer. Every earlier MISO
+ * reading was taken with a 1 us gap between samples, which cannot resolve a
+ * 12 MHz clock; this samples the DIN word back to back instead, so a pad that
+ * never changes proves the controller is not driving it.
+ */
+static void
+mt_spi_pad_watch(void)
+{
+	static uint8_t tx[64];
+	static uint8_t rx[64];
+	for (unsigned i = 0; i < sizeof(tx); ++i) {
+		tx[i] = (uint8_t)(i * 7u + 3u);
+	}
+	memset(rx, 0, sizeof(rx));
+
+	uint32_t low = 0, high = 0, samples = 0;
+	mt_spi_reset();
+	(void)mt_spi_rd(MTK_SPI_STATUS0);
+	mt_spi_wr(MTK_SPI_PAD_SEL, 1u);
+	mt_spi_wr(MTK_SPI_CFG2, 8u | (8u << 16));
+	mt_spi_wr(MTK_SPI_CFG0, ((300u - 1u) << 16) | (30u - 1u));
+	uint32_t cfg1 = mt_spi_rd(MTK_SPI_CFG1);
+	cfg1 &= ~(0xffff0000u | 0x0000ff00u | 0x000000ffu);
+	cfg1 |= ((uint32_t)(sizeof(tx) - 1u) << 16) | 17u;
+	mt_spi_wr(MTK_SPI_CFG1, cfg1);
+	mt_spi_wr(MTK_SPI_CFG3, 0);
+
+	uint32_t cmd = MTK_SPI_CMD_NONIDLE | MTK_SPI_CMD_TXMSBF | MTK_SPI_CMD_RXMSBF;
+	cmd &= ~(MTK_SPI_CMD_SAMPLE_SEL | MTK_SPI_CMD_CPHA | MTK_SPI_CMD_CPOL |
+	    MTK_SPI_CMD_RX_DMA | MTK_SPI_CMD_TX_DMA | MTK_SPI_CMD_RX_ENDIAN |
+	    MTK_SPI_CMD_TX_ENDIAN | MTK_SPI_CMD_FINISH_IE | MTK_SPI_CMD_PAUSE_IE |
+	    MTK_SPI_CMD_SPIM_LOOP | MTK_SPI_CMD_DEASSERT | MTK_SPI_CMD_PAUSE_EN |
+	    MTK_SPI_CMD_ACT | MTK_SPI_CMD_RESUME);
+	mt_spi_wr(MTK_SPI_CMD, cmd);
+
+	for (unsigned i = 0; i < sizeof(tx); i += 4) {
+		uint32_t word = 0;
+		for (unsigned b = 0; b < 4; ++b) {
+			word |= (uint32_t)tx[i + b] << (8u * b);
+		}
+		mt_spi_wr(MTK_SPI_TX_DATA, word);
+	}
+
+	mt_spi_wr(MTK_SPI_CMD, cmd | MTK_SPI_CMD_ACT);
+	for (unsigned i = 0; i < 200000; ++i) {
+		uint32_t din = mt_din_pins_164();
+		low |= (~din) & 0xfu;
+		high |= din;
+		samples++;
+		if (mt_spi_rd(MTK_SPI_STATUS0) &
+		    (MTK_SPI_FINISH_INT_STATUS | MTK_SPI_PAUSE_INT_STATUS)) {
+			break;
+		}
+	}
+	uint32_t packed = 0;
+	for (unsigned i = 0; i < 4; ++i) {
+		packed |= ((low >> i) & 1u) << (2u * i);
+		packed |= ((high >> i) & 1u) << (2u * i + 1u);
+	}
+	mt_spi_wr(MTK_SPI_CMD, cmd | MTK_SPI_CMD_PAUSE_EN);
+	(void)mt_spi_rd(MTK_SPI_STATUS0);
+	sweet_mark(175, ((uint64_t)packed << 32) | samples, mt_spi_rd(MTK_SPI_STATUS1));
+	printf("SWEET MT TOUCH: pads low=%#x high=%#x samples=%u\n",
+	    low, high, samples);
+}
+
+/* Per-transfer overrides; the production path keeps every field at zero. */
+/*
+ * Comparison sweep, enabled only by sweettouchsweep=1.
+ *
+ * 110 CFG3 / PAD_SEL as the boot firmware left them, then STATUS0
+ * 111 internal loopback (SPIM_LOOP): controller, clock and FIFO path
+ * 112 baseline (4 address bytes, CFG3 written to zero, PAD_SEL 1)
+ * 113 4 address bytes, CFG3 kept with only HALF_DUPLEX_EN cleared
+ * 114 3 address bytes, CFG3 kept
+ * 115 PAD_SEL 0, CFG3 kept
+ * 116 SAMPLE_SEL 1, CFG3 kept
+ * 117 STATUS1 of 112..115, 118 of 116 plus final CFG3/PAD_SEL
+ * 119 transfer time (ns)
+ * 120 pad mode before/after the mux write (also emitted by the init snapshot)
+ * 122 touch reset pad loopback: a=DIN low<<1|high, b=DOUT
+ * 123 baseline pad observation, 124 loopback pad observation
+ */
+static void
+mt_spi_sweep(void)
+{
+	static const uint8_t loop_tx[8] = {
+		0xa5, 0x5a, 0x3c, 0xc3, 0x0f, 0xf0, 0x96, 0x69,
+	};
+	/* 0xFB HW_REG_R at DCHIP_ID 0x20000000, then dummy bytes. */
+	static const uint8_t id_tx4[8] = {
+		0xfb, 0x20, 0x00, 0x00, 0x00, 0xff, 0xff, 0xff,
+	};
+	static const uint8_t id_tx3[8] = {
+		0xfb, 0x20, 0x00, 0x00, 0xff, 0xff, 0xff, 0xff,
+	};
+	uint8_t rx[8], brx[8];
+	struct mt_spi_opts o;
+	struct mt_spi_obs obs;
+	uint64_t loop_ns = 0, base_ns = 0;
+	int err;
+
+	mt_spi_pad_watch();
+	sweet_mark(110, ((uint64_t)mt_spi_rd(MTK_SPI_CFG3) << 32) |
+	    mt_spi_rd(MTK_SPI_PAD_SEL), mt_spi_rd(MTK_SPI_STATUS0));
+
+	/* Rails first: this is the last untested dependency of the chip. */
+	mt_supply_probe(141);
+
+	uint32_t ies_before = 0;
+	uint32_t ies_after = mt_spi_ies_enable(&ies_before);
+	sweet_mark(135, ((uint64_t)ies_before << 32) | ies_after,
+	    mt_mmio_rd(mt.iocfg_bm, MTK_IOCFG_DRV_WORD));
+	printf("SWEET MT TOUCH: ies before=%#x after=%#x drv=%#x\n",
+	    ies_before, ies_after, mt_mmio_rd(mt.iocfg_bm, MTK_IOCFG_DRV_WORD));
+	mt_reset_pad_check();
+
+	memset(&o, 0, sizeof(o));
+	o.pad_sel = 1;
+	o.loop = true;
+	memset(&obs, 0, sizeof(obs));
+	memset(rx, 0xee, sizeof(rx));
+	err = mt_spi_xfer_opts(loop_tx, rx, sizeof(rx), &o, &obs);
+	loop_ns = obs.elapsed_ns;
+	sweet_mark(111, ((uint64_t)mt_pack4(rx) << 32) | (uint32_t)err,
+	    ((uint64_t)mt_pack4(rx + 4) << 32) |
+	    (uint32_t)(memcmp(rx, loop_tx, sizeof(loop_tx)) == 0));
+	sweet_mark(124, ((uint64_t)obs.din_idle << 32) | obs.din_seen,
+	    ((uint64_t)obs.status1 << 32) | (uint32_t)obs.elapsed_ns);
+	printf("SWEET MT TOUCH: loopback err=%d rx=%02x%02x%02x%02x%02x%02x%02x%02x din=%#x seen=%#x\n",
+	    err, rx[0], rx[1], rx[2], rx[3], rx[4], rx[5], rx[6], rx[7],
+	    obs.din_idle, obs.din_seen);
+
+	memset(&o, 0, sizeof(o));
+	o.pad_sel = 1;
+	memset(&obs, 0, sizeof(obs));
+	memset(rx, 0xee, sizeof(rx));
+	err = mt_spi_xfer_opts(id_tx4, rx, sizeof(rx), &o, &obs);
+	base_ns = obs.elapsed_ns;
+	sweet_mark(112, mt_pack4(rx), mt_pack4(rx + 4));
+	sweet_mark(123, ((uint64_t)obs.din_idle << 32) | obs.din_seen,
+	    ((uint64_t)obs.status1 << 32) | (uint32_t)obs.elapsed_ns);
+	sweet_mark(117, obs.status1, 0);
+	printf("SWEET MT TOUCH: sweep err=%d rx=%02x%02x%02x%02x%02x%02x%02x%02x din=%#x seen=%#x\n",
+	    err, rx[0], rx[1], rx[2], rx[3], rx[4], rx[5], rx[6], rx[7],
+	    obs.din_idle, obs.din_seen);
+
+	uint32_t irq_low = 0, irq_high = 0;
+	for (unsigned i = 0; i < 32; ++i) {
+		unsigned v = mt_gpio_din(8);
+		irq_low |= (uint32_t)(v == 0);
+		irq_high |= (uint32_t)(v == 1);
+		delay(1);
+	}
+	sweet_mark(134, ((uint64_t)irq_high << 32) | irq_low, mt_mmio_rd(mt.pio, 0x440u));
+	printf("SWEET MT TOUCH: irq8 low=%u high=%u\n", irq_low, irq_high);
+
+	mt_spi_bitbang(id_tx4, brx, sizeof(brx), 130);
+	mt_spi_bitbang(id_tx3, brx, sizeof(brx), 131);
+
+	/* PU/PD words must match Recovery's pinconf (165 pull-up, rest pull-down) */
+	sweet_mark(136, mt_mmio_rd(mt.iocfg_bm, 0x0070u),
+	    mt_mmio_rd(mt.iocfg_bm, 0x00a0u));
+
+	/* Touch IRQ pad: enable its input, then watch the chip's INT level. */
+	if (!mt.iocfg_bm2) mt.iocfg_bm2 = ml_io_map(MTK_IOCFG_BM2_PA, 0x1000u);
+	uint32_t irq_ies_before = mt_mmio_rd(mt.iocfg_bm2, 0x0060u);
+	mt_mmio_wr(mt.iocfg_bm2, 0x0060u, irq_ies_before | (1u << 16));
+	uint32_t irq_ies_after = mt_mmio_rd(mt.iocfg_bm2, 0x0060u);
+	sweet_mark(137, ((uint64_t)irq_ies_before << 32) | irq_ies_after, 0);
+	uint32_t irq_low2 = 0, irq_high2 = 0;
+	for (unsigned i = 0; i < 64; ++i) {
+		unsigned v = mt_gpio_din(8);
+		irq_low2 |= (uint32_t)(v == 0);
+		irq_high2 |= (uint32_t)(v == 1);
+		delay(1);
+	}
