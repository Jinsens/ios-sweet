+/*
+ * One register read through the PMIF software interface. A command that
+ * returns an error must still have its valid flag cleared, otherwise the
+ * channel stays in WFVLDCLR and every later transfer fails: retry the whole
+ * sequence a few times and always clear.
+ */
+static int
+sp_pmif_read(unsigned sid, unsigned addr, uint8_t *out)
+{
+	uint32_t sta = 0, data = 0;
+	unsigned i;
+
+	for (unsigned attempt = 0; attempt < 3; ++attempt) {
+		sp_sta_pre = sp_rd(sp_pmif, PMIF_SWINF_STA);
+		for (i = 0; i < 200; ++i) {
+			if (((sp_sta_pre >> 1) & 7u) == SWINF_IDLE) {
+				break;
+			}
+			delay(1);
+			sp_sta_pre = sp_rd(sp_pmif, PMIF_SWINF_STA);
+		}
+		if (((sp_sta_pre >> 1) & 7u) != SWINF_IDLE) {
+			(void)sp_pmif_clear();
+			continue;
+		}
+
+		uint32_t cmd = (PMIF_CMD_REG << 30) | ((sid & 0xfu) << 24) |
+		    (0u << 16) | (addr & 0xffffu);
+		sp_wr(sp_pmif, PMIF_SWINF_ACC, cmd);
+		for (i = 0; i < 500; ++i) {
+			sta = sp_rd(sp_pmif, PMIF_SWINF_STA);
+			if (((sta >> 1) & 7u) == SWINF_WFVLDCLR ||
+			    ((sta >> 18) & 1u)) {
+				break;
+			}
+			delay(1);
+		}
+		sp_sta_post = sta;
+		sp_last_sta = sta;
+		if (i == 500) {
+			(void)sp_pmif_clear();
+			continue;
+		}
+		if ((sta >> 18) & 1u) {
+			(void)sp_pmif_clear();
+			continue;
+		}
+		data = sp_rd(sp_pmif, PMIF_SWINF_RDATA);
+		if (!sp_pmif_clear()) {
+			/* The byte is valid; the flag clear lagged but will retry. */
+		}
+		*out = (uint8_t)data;
+		return 0;
+	}
