+/* Clear the valid flag and wait for the software interface to go idle. */
+static bool
+sp_pmif_clear(void)
+{
+	uint32_t sta = 0;
+	for (unsigned i = 0; i < 3; ++i) {
+		sp_wr(sp_pmif, PMIF_SWINF_VLD_CLR, 1u);
+		for (unsigned j = 0; j < 10; ++j) {
+			sta = sp_rd(sp_pmif, PMIF_SWINF_STA);
+			if (((sta >> 1) & 7u) == SWINF_IDLE) {
+				sp_sta_clear = sta;
+				return true;
+			}
+			delay(1);
+		}
+	}
+	sp_sta_clear = sta;
+	return false;
