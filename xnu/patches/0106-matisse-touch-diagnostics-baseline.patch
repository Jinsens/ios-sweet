+/* Drive the touch reset pad and read it back through PIO DIN. */
+static void
+mt_reset_pad_check(void)
+{
+	uint32_t dout = mt_mmio_rd(mt.pio, MTK_GPIO_DOUT0);
+	mt_mmio_wr(mt.pio, MTK_GPIO_DOUT0_CLR, MTK_TOUCH_RESET_MASK);
+	uint32_t low = (mt_mmio_rd(mt.pio, MTK_GPIO_DIN0) >>
+	    MTK_TOUCH_RESET_GPIO) & 1u;
+	mt_mmio_wr(mt.pio, MTK_GPIO_DOUT0_SET, MTK_TOUCH_RESET_MASK);
+	uint32_t high = (mt_mmio_rd(mt.pio, MTK_GPIO_DIN0) >>
+	    MTK_TOUCH_RESET_GPIO) & 1u;
+	sweet_mark(122, (low << 1) | high,
+	    (dout >> MTK_TOUCH_RESET_GPIO) & 1u);
+	printf("SWEET MT TOUCH: reset pad din low=%u high=%u\n", low, high);
+}
