+/*
+ * MTK PIO blocks cover 32 pins per 0x10 window: data at +0x0, set at +0x4,
+ * clear at +0x8. Mode windows cover 8 pins per 0x10 with the write alias at
+ * +0xC, which is why pins 160..167 use 0x440 / 0x44c.
+ */
+#define MTK_PIO_BLOCK(base, pin) ((base) + ((pin) / 32u) * 0x10u)
+#define MTK_PIO_MODE_WIN(pin)    (0x300u + ((pin) / 8u) * 0x10u)
+#define MTK_PIO_MODE_MWR(pin)    (MTK_PIO_MODE_WIN(pin) + 0xcu)
+
+static uint32_t
+mt_gpio_din(unsigned pin)
+{
+	return (mt_mmio_rd(mt.pio, MTK_PIO_BLOCK(MTK_GPIO_DIN0, pin)) >>
+	    (pin % 32u)) & 1u;
+}
+
+static void
+mt_gpio_data(unsigned pin, bool high)
+{
+	mt_mmio_wr(mt.pio, MTK_PIO_BLOCK(MTK_GPIO_DOUT0, pin) + (high ? 4u : 8u),
+	    1u << (pin % 32u));
+}
+
+/*
+ * Set the four mode nibbles of a pin group. The +0xC alias used earlier is a
+ * no-op on this silicon, so try the data register first and fall back to the
+ * +0x4 window only when the readback did not change.
+ */
+static uint32_t
+mt_pio_mode_set(unsigned pin, uint32_t value)
+{
+	mt_mmio_wr(mt.pio, MTK_PIO_MODE_WIN(pin), value);
+	uint32_t after = mt_mmio_rd(mt.pio, MTK_PIO_MODE_WIN(pin));
+	if (after != value) {
+		mt_mmio_wr(mt.pio, MTK_PIO_MODE_WIN(pin) + 0x4u, value);
+		after = mt_mmio_rd(mt.pio, MTK_PIO_MODE_WIN(pin));
+	}
+	return after;
+}
+
+/*
+ * MT6983 IES (input enable) bits of GPIO164..167 live in the IOCFG_BM word at
+ * +0x0050: pin164 bit15, pin165 bit14, pin166 bit16, pin167 bit13. Without
+ * them the MISO pad never reaches the controller and every read returns 0.
+ */
+static const unsigned mt_spi_ies_bit[4] = { 15, 14, 16, 13 };
+
+static uint32_t
+mt_spi_ies_enable(uint32_t *before)
+{
+	if (!mt.iocfg_bm) {
+		return 0;
+	}
+	uint32_t word = mt_mmio_rd(mt.iocfg_bm, MTK_IOCFG_IES_WORD);
+	if (before) {
+		*before = word;
+	}
+	for (unsigned i = 0; i < 4; ++i) {
+		word |= 1u << mt_spi_ies_bit[i];
+	}
+	mt_mmio_wr(mt.iocfg_bm, MTK_IOCFG_IES_WORD, word);
+	return mt_mmio_rd(mt.iocfg_bm, MTK_IOCFG_IES_WORD);
+}
+
+static void
+mt_gpio_dir(unsigned pin, bool output)
+{
+	mt_mmio_wr(mt.pio, MTK_PIO_BLOCK(MTK_GPIO_DIR0, pin) + (output ? 4u : 8u),
+	    1u << (pin % 32u));
+}
