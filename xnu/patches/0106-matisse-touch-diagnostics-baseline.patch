+/*
+ * Clock the FTS header out by hand on MI/CSB/MO/CLK as plain GPIO. This
+ * bypasses the SPI6 controller, PAD_SEL and every mux question: an answer here
+ * proves the pads and the chip work and puts the fault in the controller path.
+ */
+static void
+mt_spi_bitbang(const uint8_t *tx, uint8_t *rx, unsigned len, uint32_t mark_id)
+{
+	uint32_t mode = mt_mmio_rd(mt.pio, MTK_PIO_MODE_WIN(164));
+	uint32_t gpio = mt_pio_mode_set(164, mode & 0xffffu);
+	sweet_mark(133, ((uint64_t)mode << 32) | gpio,
+	    mt_mmio_rd(mt.pio, MTK_PIO_BLOCK(MTK_GPIO_DIR0, 164)));
+	printf("SWEET MT TOUCH: mode gpio before=%#x after=%#x\n", mode, gpio);
+	mt_gpio_dir(164, false);
+	mt_gpio_dir(165, true);
+	mt_gpio_dir(166, true);
+	mt_gpio_dir(167, true);
+	mt_gpio_data(166, false);
+	mt_gpio_data(167, false);
+	mt_gpio_data(165, true);
+	delay(50);
+
+	uint32_t idle = mt_gpio_din(164) | (mt_gpio_din(165) << 1) |
+	    (mt_gpio_din(166) << 2) | (mt_gpio_din(167) << 3);
+	if (mark_id == 130) {
+		sweet_mark(132, ((uint64_t)idle << 32) | (mode & 0xffffffffu),
+		    mt_mmio_rd(mt.pio, 0x440u));
+		printf("SWEET MT TOUCH: bitbang idle din=%#x mode=%#x\n", idle, mode);
+	}
+
+	mt_gpio_data(165, false);
+	delay(2);
+	memset(rx, 0, len);
+	for (unsigned i = 0; i < len * 8; ++i) {
+		mt_gpio_data(166, ((tx[i / 8] >> (7u - (i % 8))) & 1u) != 0);
+		delay(1);
+		mt_gpio_data(167, true);
+		delay(1);
+		unsigned bit = mt_gpio_din(164);
+		rx[i / 8] = (uint8_t)((rx[i / 8] << 1) | bit);
+		mt_gpio_data(167, false);
+		delay(1);
+	}
+	mt_gpio_data(165, true);
+	delay(2);
+	mt_pio_mode_set(164, mode);
+	sweet_mark(mark_id, mt_pack4(rx), mt_pack4(rx + 4));
+	printf("SWEET MT TOUCH: bitbang %u rx=%02x%02x%02x%02x%02x%02x%02x%02x\n",
+	    mark_id, rx[0], rx[1], rx[2], rx[3], rx[4], rx[5], rx[6], rx[7]);
+}
