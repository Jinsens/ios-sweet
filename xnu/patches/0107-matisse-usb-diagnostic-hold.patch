+	sweet_mark(43, 0, 0);
 	for (;;) {
 		mt_poll();
-		if ((++ticks % 30000) == 0) {
+		mt.polls++;
+		if (ticks == 0) {
+			sweet_mark(44, mt_rd(MAC_EP0CSR), mt_rd(MAC_COMMON_USB_INTR));
+		}
+		if (++ticks == 1000) {
+			sweet_mark(45, ((uint64_t)mt.setups << 32) | mt.resets,
+			    mt_rd(MAC_EP0CSR));
+		}
+		if ((ticks % 30000) == 0) {
 			mt_status();
 		}
 		mt_sleep_ms(1);
 	}
+}
+
+/*
+ * Post-mortem snapshot, called from bsd_init just before launchd so the
+ * values describe the state after the diagnostic hold, not the probe.
+ */
+void
+sweet_mtu3_snapshot(void)
+{
+	if (mt.mac == 0) {
+		return;
+	}
+	sweet_mark(46, mt.polls, ((uint64_t)mt.setups << 32) | mt.resets);
+	sweet_mark(47, mt_rd(MAC_EP0CSR),
+	    ((uint64_t)mt_rd(MAC_COMMON_USB_INTR) << 32) | mt_rd(MAC_DEV_LINK_INTR));
+	sweet_mark(48, mt_rd(MAC_DEVICE_CONF),
+	    ((uint64_t)mt_rd(MAC_POWER_MANAGEMENT) << 32) | (uint64_t)mt_speed());
+	sweet_mark(49, mt_rd(MAC_LINK_STATE_MACHINE),
+	    ((uint64_t)mt_rd(MAC_USB20_OPSTATE) << 32) | (mt.configured ? 1u : 0u));
 }
 
