--- a/bsd/kern/bsd_init.c
+++ b/bsd/kern/bsd_init.c
@@ -1150,6 +1150,33 @@
 		}
 		sweet_mark(102, touch_hold_s, 0);
 	}
+	/*
+	 * Diagnostic only: keep the kernel alive after the USB soft-connect so
+	 * the host has time to enumerate. The MTU3 poll thread is created in
+	 * sweet_usb_probe(), well before this point, but without the hold the
+	 * missing-launchd panic stops it within a fraction of a second - the
+	 * same reason the touch worker needed sweettouchhold. The snapshot
+	 * after the hold records what the controller and EP0 did meanwhile.
+	 */
+	unsigned usb_hold_s = 0;
+	(void)PE_parse_boot_argn("sweetusbhold", &usb_hold_s, sizeof(usb_hold_s));
+	if (usb_hold_s > 120) {
+		usb_hold_s = 120;
+	}
+	if (usb_hold_s != 0) {
+		extern void sweet_mtu3_snapshot(void);
+		static int usb_hold_chan;
+		sweet_mark(105, usb_hold_s, 0);
+		printf("SWEET MTU3: USB diagnostic hold %u seconds\n", usb_hold_s);
+		for (unsigned second = 0; second < usb_hold_s; ++second) {
+			uint64_t deadline;
+			clock_interval_to_deadline(1000, NSEC_PER_MSEC, &deadline);
+			(void)assert_wait_deadline(&usb_hold_chan, THREAD_UNINT, deadline);
+			thread_block(THREAD_CONTINUE_NULL);
+		}
+		sweet_mtu3_snapshot();
+		sweet_mark(106, usb_hold_s, 0);
+	}
 	load_init_program(p);
 	sweet_mark(61, 0, 0);
 	lock_trace = 1;
