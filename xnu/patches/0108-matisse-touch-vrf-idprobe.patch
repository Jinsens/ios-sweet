+/*
+ * Two questions answered with the SPI6 controller out of the path.
+ *
+ * 1. INT. Every earlier sample read GPIO8 without ever selecting GPIO function
+ *    0 for it: LK leaves that pad however the boot firmware set it, and a pin
+ *    that is still muxed to another block reads 0 in the GPIO DIN register
+ *    whatever the chip is doing. Recovery's pinmux shows 'GPIO8: MUX
+ *    UNCLAIMED' (function 0, no bias, input enabled), so this reproduces that
+ *    exactly and samples again - apples to apples with the 'in hi' that
+ *    /sys/kernel/debug/gpio reports while touch works.
+ *
+ * 2. Chip ID over hand-clocked SPI at ~500 kHz, after the vendor driver's
+ *    one-byte system reset (0x81). SCK at 12 MHz is far below any pad limit,
+ *    so a reply here proves the chip is powered and out of reset and puts the
+ *    fault in the controller programming; silence leaves the chip itself.
+ */
 static void
+mt_id_probe(void)
+{
+	uint32_t win = mt_mmio_rd(mt.pio, MTK_PIO_MODE_WIN(8));
+	uint32_t after = mt_pio_mode_set(8, win & ~0x0fu);
+	mt_gpio_dir(8, false);
+	if (!mt.iocfg_bm2) {
+		mt.iocfg_bm2 = ml_io_map(MTK_IOCFG_BM2_PA, 0x1000u);
+	}
+	uint32_t ies = mt_mmio_rd(mt.iocfg_bm2, 0x0060u);
+	mt_mmio_wr(mt.iocfg_bm2, 0x0060u, ies | (1u << 16));
+	delay(2000);
+
+	unsigned hi = 0, lo = 0;
+	for (unsigned i = 0; i < 64; ++i) {
+		uint32_t v = mt_gpio_din(8);
+		hi |= (uint32_t)(v == 1);
+		lo |= (uint32_t)(v == 0);
+		delay(1);
+	}
+	sweet_mark(154, ((uint64_t)hi << 32) | lo,
+	    ((uint64_t)win << 32) | after);
+	printf("SWEET MT TOUCH: int probe win=%#x->%#x ies=%#x hi=%u lo=%u\n",
+	    win, after, ies, hi, lo);
+
+	uint8_t rst = 0x81, rst_rx = 0;
+	mt_spi_bitbang(&rst, &rst_rx, 1, 156);
+	delay(20000);
+
+	uint8_t tx[8] = {
+	    FTS_CMD_HW_REG_R,
+	    (uint8_t)(FTS_ADDR_DCHIP_ID >> 24),
+	    (uint8_t)(FTS_ADDR_DCHIP_ID >> 16),
+	    (uint8_t)(FTS_ADDR_DCHIP_ID >> 8),
+	    (uint8_t)FTS_ADDR_DCHIP_ID,
+	    0xff, 0xff, 0xff,
+	};
+	uint8_t rx[8];
+	mt_spi_bitbang(tx, rx, sizeof(rx), 157);
+	mt_spi_bitbang(tx, rx, sizeof(rx), 158);
+}
