+/*
+ * The one rail write that has never taken the SoC down: raise VRF18_AIF to
+ * its device-tree 1.8 V while the LDO is still disabled, then set its enable
+ * bit. mt6373-regulator.ko (Recovery's module, pulled from the stock
+ * vendor_boot ramdisk) gives VRF18_AIF desc.vsel_reg = 0x1e8d, vsel_mask =
+ * 0xf, enable_reg = 0x1bbf, enable value 0x01, ldo_volt_table3[12] = 1800 mV,
+ * so this is byte-for-byte what regulator_enable() does on the working boot.
+ *
+ * VTP is deliberately not touched here: it is already enabled (0x1d23 = 0x03,
+ * EN=1 LP=1) at selector 4 (1.8 V) when XNU starts, every write that changes
+ * 0x1d23 or its selector has reset the SoC, and Recovery's regulator_summary
+ * lists spi6.0-avdd as VTP's only consumer - so the reset is not a load
+ * brownout and the sequence, not the voltage, is what needs fixing.
+ */
+static void
+mt_vrf_enable_only(void)
+{
+	uint8_t vrf = 0, vsel = 0, vtp = 0, a = 0, b = 0, c = 0;
+
+	if (sweet_spmi_init() != 0) {
+		printf("SWEET MT TOUCH: vrf-only skipped, SPMI unavailable\n");
+		return;
+	}
+	int e0 = sweet_spmi_read(5, 0x1bbf, &vrf);
+	int e1 = sweet_spmi_read(5, 0x1e8d, &vsel);
+	int e2 = sweet_spmi_read(5, 0x1d23, &vtp);
+	if (e0 != 0 || e1 != 0) {
+		sweet_mark(155, ((uint64_t)(uint32_t)e0 << 32) | (uint32_t)e1, 0x56524600);
+		printf("SWEET MT TOUCH: vrf-only skipped, read failed %d/%d\n", e0, e1);
+		return;
 	}
+
+	int ramp = -1;
+	if ((vsel & 0x0fu) != 12u) {	/* table3[12] = 1.8 V */
+		ramp = mt_rail_ramp(0x1e8d, vsel, 12u, 194);
+	}
+	int en = -1;
+	if ((vrf & 1u) == 0) {
+		en = sweet_spmi_write(5, 0x1bbf, 1u);
+	}
+	delay(20000);
+
+	(void)sweet_spmi_read(5, 0x1bbf, &a);
+	(void)sweet_spmi_read(5, 0x1e8d, &b);
+	(void)sweet_spmi_read(5, 0x1d23, &c);
+	sweet_mark(155, ((uint64_t)a << 32) | vrf, ((uint64_t)b << 32) | vsel);
+	printf("SWEET MT TOUCH: vrf only vsel=%#x->%#x ramp=%d en=%d "
+	    "vrf=%#x->%#x vtp=%#x/%d\n", vsel, b, ramp, en, vrf, a, c, e2);
 }
 
