+/* L11 SALIXP: reset -> Controller Ready -> valid System Info -> Sense On. */
+static int
+mt_fts_start_sensing(void)
+{
+	const uint8_t reset[] = { 0xfa, 0x20, 0x00, 0x00, 0x24, 0x81 };
+	uint8_t rx[28] = {0};
+	int err = mt_spi_xfer(reset, rx, sizeof(reset));
+	if (err) return err;
+
+	bool ready = false;
+	for (unsigned i = 0; i < 20; ++i) {
+		uint8_t event[FTS_EVENT_SIZE] = {0};
+		err = mt_fts_read_event(event);
+		if (err) return err;
+		if (event[0] == 0xf3u) return EIO; /* firmware error */
+		if (event[0] == 0x03u) { ready = true; break; }
+		mt_wait(5);
+	}
+	if (mt.trace) sweet_mark(202, ready, 100u);
+	if (!ready) return ETIMEDOUT;
+
+	/* First 24 bytes of the 208-byte System Info fit in the 32-byte FIFO. */
+	uint8_t tx[28];
+	memset(tx, 0, sizeof(tx));
+	tx[0] = 0xa7; /* SPI framebuffer read; two address bytes + one dummy */
+	memset(rx, 0, sizeof(rx));
+	err = mt_spi_xfer(tx, rx, sizeof(tx));
+	if (err) return err;
+	const uint8_t *info = rx + 4;
+	unsigned fw = info[16] | ((unsigned)info[17] << 8);
+	unsigned cfg = info[20] | ((unsigned)info[21] << 8);
+	if (mt.trace) sweet_mark(203, ((uint64_t)fw << 32) | cfg,
+	    ((uint64_t)info[0] << 8) | info[1]);
+	if (info[0] != 0xa5u || info[1] != 0x01u || fw == 0 || fw == 0xffffu) {
+		return EIO;
+	}
+
+	const uint8_t sense[] = { 0xa0, 0x00, 0x01 };
+	err = mt_spi_xfer(sense, rx, sizeof(sense));
+	if (mt.trace) sweet_mark(204, (uint32_t)err, 0xa00001u);
+	return err;
+}
