+/* Caller holds sp_lock. One long-address write, with no automatic retry. */
+static int
+sp_pmif_write_once(unsigned addr, uint8_t value)
+{
+	uint32_t sta = sp_rd(sp_pmif, PMIF_SWINF_STA);
+	if (((sta >> 1) & 7u) != SWINF_IDLE) return -1;
+	sp_wr(sp_pmif, PMIF_SWINF_WDATA, value);
+	sp_wr(sp_pmif, PMIF_SWINF_ACC,
+	    (PMIF_CMD_EXT_REG_LONG << 30) | (1u << 29) | (5u << 24) | addr);
+	for (unsigned i = 0; i < 500; ++i) {
+		sta = sp_rd(sp_pmif, PMIF_SWINF_STA);
+		if (((sta >> 1) & 7u) == SWINF_IDLE) return 0;
+		delay(1);
+	}
+	return -1;
+}
+
+/*
+ * Fixed board targets only: selector12=1.8V, selector13=3.3V, EN bit0=1.
+ * Preserve other fields; do not clear LP bits, unlock keys, or change an
+ * enabled rail's selector. The driver separately checks the cold baseline.
+ */
+int
+sweet_spmi_touch_configure(unsigned addr)
+{
+	uint8_t mask, target;
+	unsigned enable = 0;
+	switch (addr) {
+	case 0x1e8du: mask = 0x0f; target = 0x0c; enable = 0x1bbf; break;
+	case 0x1e35u: mask = 0x0f; target = 0x0d; enable = 0x1d23; break;
+	case 0x1bbfu:
+	case 0x1d23u: mask = 0x01; target = 0x01; break;
+	default: return -1;
+	}
+	if (!sp_ready || !sp_pmif_ok || !sp_lock) return -1;
+	IOLockLock(sp_lock);
+	int err = -1;
+	uint8_t identity = 0, old = 0, verify = 0, en = 0;
+	if (sp_pmif_read(5, 0x0009u, &identity) != 0 || identity != 0x73) goto out;
+	if (sp_pmif_read(5, addr, &old) != 0) goto out;
+	uint8_t value = (uint8_t)((old & (uint8_t)~mask) | target);
+	if (value == old) { err = 0; goto out; }
+	if (enable && (sp_pmif_read(5, enable, &en) != 0 || (en & 1u))) goto out;
+	if (sp_pmif_write_once(addr, value) != 0) goto out;
+	if (sp_pmif_read(5, addr, &verify) != 0 || verify != value) goto out;
+	err = 0;
+out:
+	IOLockUnlock(sp_lock);
+	return err;
+}
