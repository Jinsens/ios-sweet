+/* Run once before mountroot; leave reset asserted on every power failure. */
+static int
+mt_touch_power_on(void)
+{
+	static const unsigned reg[5] = { 0x0009u, 0x1bbfu, 0x1d23u, 0x1e8du, 0x1e35u };
+	static const uint8_t cold[5] = { 0x73, 0x00, 0x00, 0x0c, 0x04 };
+	static const uint8_t powered[5] = { 0x73, 0x01, 0x01, 0x0c, 0x0d };
+	static const unsigned sequence[4] = { 0x1e8du, 0x1e35u, 0x1bbfu, 0x1d23u };
+	if (!mt.platform_ready || !mt.pio || sweet_spmi_init() != 0) {
+		sweet_mark(205, 0xffu, 0);
+		return EIO;
+	}
+	mt_mmio_wr(mt.pio, MTK_GPIO_DOUT0_CLR, MTK_TOUCH_RESET_MASK);
+	delay(10000);
+	uint64_t snapshot = 0;
+	unsigned errors = 0;
+	for (unsigned i = 0; i < 5; ++i) {
+		uint8_t value = 0xff;
+		if (sweet_spmi_read(5, reg[i], &value) != 0 || value != cold[i]) errors |= 1u << i;
+		snapshot |= (uint64_t)value << (8 * i);
+	}
+	sweet_mark(205, errors, snapshot);
+	if (errors) return EIO;
+	for (unsigned i = 0; i < 4; ++i) {
+		int err = sweet_spmi_touch_configure(sequence[i]);
+		uint8_t readback = 0xff;
+		int rd = sweet_spmi_read(5, sequence[i], &readback);
+		sweet_mark(206, ((uint64_t)sequence[i] << 32) | (uint32_t)err,
+		    ((uint64_t)(uint32_t)rd << 32) | readback);
+		if (err || rd) return EIO;
+		if (sequence[i] == 0x1bbfu) delay(5000);
+		if (sequence[i] == 0x1d23u) delay(10000);
+	}
+	snapshot = 0;
+	errors = 0;
+	for (unsigned i = 0; i < 5; ++i) {
+		uint8_t value = 0xff;
+		if (sweet_spmi_read(5, reg[i], &value) != 0 || value != powered[i]) errors |= 1u << i;
+		snapshot |= (uint64_t)value << (8 * i);
+	}
+	sweet_mark(207, errors, snapshot);
+	if (errors) return EIO;
+	int err = mt_touch_reset_init();
+	sweet_mark(208, (uint32_t)err, 0);
+	return err;
+}
