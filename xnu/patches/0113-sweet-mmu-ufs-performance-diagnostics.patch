+#if defined(ARM64_BOARD_CONFIG_SWEET)
+/* Best-effort diagnostic: never page in target memory or copy Device/NC RAM.
+ * Hold pmap and PVH locks only for this bounded resident-page copy. */
+uint64_t sweet_pmap_sample(pmap_t pmap, vm_map_address_t va, void *dst, size_t len);
+uint64_t
+sweet_pmap_sample(pmap_t pmap, vm_map_address_t va, void *dst, size_t len)
+{
+	pt_entry_t entry = 0;
+	pmap_lock(pmap, PMAP_LOCK_SHARED);
+	const pt_attr_t *attr = pmap_get_pt_attr(pmap);
+	for (unsigned int level = attr->pta_root_level; level <= attr->pta_max_level; level++) {
+		tt_entry_t *ptr = pmap_ttne(pmap, level, va);
+		if (ptr == TT_ENTRY_NULL) {
+			break;
+		}
+		entry = *(volatile tt_entry_t *)ptr;
+		if (!(entry & ARM_TTE_VALID)) {
+			entry = 0;
+			break;
+		}
+		if (level != attr->pta_max_level && (entry & ARM_TTE_TYPE_MASK) == ARM_TTE_TYPE_TABLE) {
+			continue;
+		}
+		if (dst != NULL) {
+			const uint64_t mask = pt_attr_page_size(attr) - 1;
+			pmap_paddr_t pa = pte_to_pa(entry);
+			if (level != attr->pta_max_level || !pa_valid(pa) ||
+			    (entry & ARM_PTE_ATTRINDXMASK) != ARM_PTE_ATTRINDX(CACHE_ATTRINDX_WRITEBACK) ||
+			    len > pt_attr_page_size(attr) - (va & mask)) {
+				entry = 0;
+				break;
+			}
+			unsigned int pai = pa_index(pa);
+			pvh_lock(pai);
+			if (*(volatile tt_entry_t *)ptr != entry) {
+				entry = 0;
+			} else {
+				memcpy(dst, (const void *)phystokv(pa + (va & mask)), len);
+			}
+			pvh_unlock(pai);
+		}
+		break;
+	}
+	pmap_unlock(pmap, PMAP_LOCK_SHARED);
+	return entry;
+}
+#endif
