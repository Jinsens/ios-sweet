+/* Opt-in bring-up setting: HS Gear1, one lane, series A, FAST both ways.
+ * No fallback after a partial change: callers must leave the disk offline. */
+static int
+ufs_hs_g1(void)
+{
+	static const uint16_t caps[] = {
+		PA_CONNECTEDRXDATALANES, PA_CONNECTEDTXDATALANES,
+		PA_MAXRXHSGEAR, PA_MAXRXHSGEAR
+	};
+	for (unsigned int i = 0; i < 4; i++) {
+		uint32_t value = 0;
+		uint32_t error = ufs_uic(i == 3 ? 0x03 : 0x01,
+		    (uint32_t)caps[i] << 16, 0, 0, &value);
+		printf("SWEET UFS: HS cap %s attr 0x%x value %u error 0x%x\n",
+		    i == 3 ? "peer" : "local", caps[i], value, error);
+		if (error || !value) {
+			return ENOTSUP;
+		}
+	}
+	/* UniPro default protection/replay/AFC timeouts, also sent to the peer
+	 * in the power request. TXHSADAPTTYPE=PA_NO_ADAPT for MTK HS gears <4. */
+	static const struct { uint16_t attr; uint32_t value; } setup[] = {
+		{ PA_RXGEAR, 1 }, { PA_ACTIVERXDATALANES, 1 }, { PA_RXTERMINATION, 1 },
+		{ PA_TXGEAR, 1 }, { PA_ACTIVETXDATALANES, 1 }, { PA_TXTERMINATION, 1 },
+		{ PA_HSSERIES, 1 }, { PA_TXHSADAPTTYPE, 3 },
+		{ 0x15b0, 8191 }, { 0x15b1, 65535 }, { 0x15b2, 32767 },
+		{ 0x15b3, 8191 }, { 0x15b4, 65535 }, { 0x15b5, 32767 },
+		{ 0xd041, 8191 }, { 0xd042, 65535 }, { 0xd043, 32767 }
+	};
+	for (unsigned int i = 0; i < sizeof(setup) / sizeof(setup[0]); i++) {
+		uint32_t error = ufs_uic(0x02, (uint32_t)setup[i].attr << 16,
+		    0, setup[i].value, NULL);
+		if (error) {
+			printf("SWEET UFS: HS setup attr 0x%x error 0x%x\n", setup[i].attr, error);
+			return EIO;
+		}
+	}
+	int error = ufs_power_mode(0x11);
+	if (error) {
+		return error;
+	}
+	static const struct { uint16_t attr; uint32_t value; } verify[] = {
+		{ PA_RXGEAR, 1 }, { PA_TXGEAR, 1 },
+		{ PA_ACTIVERXDATALANES, 1 }, { PA_ACTIVETXDATALANES, 1 },
+		{ PA_RXTERMINATION, 1 }, { PA_TXTERMINATION, 1 },
+		{ PA_HSSERIES, 1 }, { PA_PWRMODE, 0x11 }
+	};
+	for (unsigned int i = 0; i < sizeof(verify) / sizeof(verify[0]); i++) {
+		uint32_t value = 0;
+		uint32_t result = ufs_uic(0x01, (uint32_t)verify[i].attr << 16, 0, 0, &value);
+		printf("SWEET UFS: HS verify attr 0x%x value 0x%x error 0x%x\n",
+		    verify[i].attr, value, result);
+		if (result || value != verify[i].value) {
+			return EIO;
+		}
+	}
+	return 0;
 }
 
