+/* Called once with the mutex held and writes still disabled. Compare exactly
+ * the first 4 KiB and time a 1 MiB read of the same partition range in each
+ * mode. No filesystem has been exposed and no data is written by this probe. */
+static int
+ufs_hs_validate(void)
+{
+	static uint8_t before[UFS_BLOCK];
+	const uint32_t blocks = BOUNCE_SIZE / UFS_BLOCK;
+	if (su.writable || su.nblocks < blocks) {
+		return EINVAL;
+	}
+	uint64_t start = mach_absolute_time();
+	int error = ufs_read_blocks(su.first_block, blocks);
+	uint64_t pwm_us = sweet_perf_us(mach_absolute_time() - start);
+	if (error) {
+		return error;
+	}
+	memcpy(before, (void *)(su.dma + DMA_BOUNCE), sizeof(before));
+	error = ufs_hs_g1();
+	if (error) {
+		return error;
+	}
+	start = mach_absolute_time();
+	error = ufs_read_blocks(su.first_block, blocks);
+	uint64_t hs_us = sweet_perf_us(mach_absolute_time() - start);
+	if (!error && memcmp(before, (void *)(su.dma + DMA_BOUNCE), sizeof(before))) {
+		error = EIO;
+	}
+	printf("SWEET UFS: HS readcheck bytes %u compare_bytes %u pwm_us %llu hs_us %llu error %d\n",
+	    BOUNCE_SIZE, UFS_BLOCK, pwm_us, hs_us, error);
+	return error;
+}
