+/* A successful DME_SET alone does not complete a power-mode transition.
+ * Wait for UPMS as well and require the local request to have succeeded. */
+static int
+ufs_power_mode(uint32_t mode)
+{
+	ufs_wr(REG_IS, IS_UIC_PWRMODE);
+	uint32_t error = ufs_uic(0x02, PA_PWRMODE << 16, 0, mode, NULL);
+	if (error) {
+		printf("SWEET UFS: power mode 0x%x DME error 0x%x\n", mode, error);
+		return EIO;
+	}
+	for (int i = 0; i < 500000 && !(ufs_rd(REG_IS) & IS_UIC_PWRMODE); i++) {
+		delay(1);
+	}
+	uint32_t is = ufs_rd(REG_IS), hcs = ufs_rd(REG_HCS);
+	if (!(is & IS_UIC_PWRMODE) || (hcs & HCS_PWR_MASK) != HCS_PWR_LOCAL) {
+		printf("SWEET UFS: power mode 0x%x incomplete IS 0x%x HCS 0x%x\n", mode, is, hcs);
+		return EIO;
+	}
+	ufs_wr(REG_IS, IS_UIC_PWRMODE);
+	return 0;
+}
